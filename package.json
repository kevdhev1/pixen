{
  "name": "pixen",
  "version": "0.0.0",
  "private": "true",
  "description": "CLI tool for capturing, downloading, and organizing web design references.",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/pixen/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "author": "Kevin Marquez",
  "license": "AGPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "pdfkit": "^0.20.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
