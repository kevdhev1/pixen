{
  "name": "pixen",
  "version": "0.0.0",
  "private": "true",
  "description": "CLI tool for capturing, downloading, and organizing web design references.",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/pixen/cli/index.ts",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "bin": {
    "pixen": "./dist/pixen/cli/index.js"
  },
  "author": "Kevin Marquez",
  "license": "AGPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "pdfkit": "^0.20.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "pdfjs-dist": "^6.4.299",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
